# Banco de dados
MYSQL_DATABASE=transport
MYSQL_USER=transport
MYSQL_PASSWORD=troque-esta-senha
MYSQL_ROOT_PASSWORD=troque-esta-senha-root
DATABASE_URL=mysql://transport:troque-esta-senha@db:3306/transport

# API
API_ADDR=0.0.0.0:8080
JWT_SECRET=troque-por-uma-chave-aleatoria-de-32-bytes-ou-mais
